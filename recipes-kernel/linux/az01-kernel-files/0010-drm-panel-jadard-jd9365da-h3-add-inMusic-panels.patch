From 6a0e1f5401342a5099f3946178ae74741d7f7785 Mon Sep 17 00:00:00 2001
From: Dylan Corrales <deathcamel58@gmail.com>
Date: Tue, 6 Oct 2026 11:10:49 -0400
Subject: [PATCH] drm/panel: jadard-jd9365da-h3: Add the inMusic panels

Add the four JD9365-based 800x1280 MIPI-DSI panels inMusic fits to its
AZ01 devices: urt,umo-9399md-1t, urt,umo-9399md-4t, urt,umoh-9344md-t
and urt,umoh-9522md-1t. The init sequences are the ones the vendor's
bootloader sends, replayed unchanged; the two table-driven ones are
followed by the page 0 select and tearing-effect enable its driver
appends. Timings and DSI flags are the vendor's, except that
9399md-4t runs at 73000 kHz rather than u-boot's 72927, as the vendor
kernel does.

Supporting them needs five driver changes. The first four are
equivalent to later upstream commits, which do not apply to this kernel
as they stand:

- Reset polarity: assert reset with 1 and release it with 0, so prepare
  no longer leaves the panel held in reset, and reset is released before
  power-off (upstream a8972d5a49b4 and 095c8e61f4c7).
- Send the init sequence, sleep-out and display-on from prepare(),
  before the DSI host starts the video stream, instead of from enable()
  (upstream 97d1f449c359 and the change before it). Sent after video
  had started, a Prime 4+ came up with its color channels rotated.
- Panel orientation from the "rotation" property (upstream
  e1c550898f75).
- Per-panel DSI mode flags, as upstream later allowed (eb019688f2a9);
  panels that set none keep the driver's default.
- With no vdd-supply in the device tree, use the "power" supply as vdd.
  The inMusic device trees predate the vdd/vccio binding.

Upstream-Status: Inappropriate [adapted backports plus vendor board support]
---
 .../gpu/drm/panel/panel-jadard-jd9365da-h3.c  | 971 +++++++++++++++++-
 1 file changed, 929 insertions(+), 42 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-jadard-jd9365da-h3.c b/drivers/gpu/drm/panel/panel-jadard-jd9365da-h3.c
index 4879835..92a65ef 100644
--- a/drivers/gpu/drm/panel/panel-jadard-jd9365da-h3.c
+++ b/drivers/gpu/drm/panel/panel-jadard-jd9365da-h3.c
@@ -31,6 +31,7 @@ struct jadard_panel_desc {
 	enum mipi_dsi_pixel_format format;
 	const struct jadard_init_cmd *init_cmds;
 	u32 num_init_cmds;
+	unsigned long mode_flags;	/* 0: the driver's default */
 };
 
 struct jadard {
@@ -41,6 +42,7 @@ struct jadard {
 	struct regulator *vdd;
 	struct regulator *vccio;
 	struct gpio_desc *reset;
+	enum drm_panel_orientation orientation;
 };
 
 static inline struct jadard *panel_to_jadard(struct drm_panel *panel)
@@ -48,38 +50,6 @@ static inline struct jadard *panel_to_jadard(struct drm_panel *panel)
 	return container_of(panel, struct jadard, panel);
 }
 
-static int jadard_enable(struct drm_panel *panel)
-{
-	struct device *dev = panel->dev;
-	struct jadard *jadard = panel_to_jadard(panel);
-	const struct jadard_panel_desc *desc = jadard->desc;
-	struct mipi_dsi_device *dsi = jadard->dsi;
-	unsigned int i;
-	int err;
-
-	msleep(10);
-
-	for (i = 0; i < desc->num_init_cmds; i++) {
-		const struct jadard_init_cmd *cmd = &desc->init_cmds[i];
-
-		err = mipi_dsi_dcs_write_buffer(dsi, cmd->data, JD9365DA_INIT_CMD_LEN);
-		if (err < 0)
-			return err;
-	}
-
-	msleep(120);
-
-	err = mipi_dsi_dcs_exit_sleep_mode(dsi);
-	if (err < 0)
-		DRM_DEV_ERROR(dev, "failed to exit sleep mode ret = %d\n", err);
-
-	err =  mipi_dsi_dcs_set_display_on(dsi);
-	if (err < 0)
-		DRM_DEV_ERROR(dev, "failed to set display on ret = %d\n", err);
-
-	return 0;
-}
-
 static int jadard_disable(struct drm_panel *panel)
 {
 	struct device *dev = panel->dev;
@@ -100,6 +70,9 @@ static int jadard_disable(struct drm_panel *panel)
 static int jadard_prepare(struct drm_panel *panel)
 {
 	struct jadard *jadard = panel_to_jadard(panel);
+	const struct jadard_panel_desc *desc = jadard->desc;
+	struct mipi_dsi_device *dsi = jadard->dsi;
+	unsigned int i;
 	int ret;
 
 	ret = regulator_enable(jadard->vccio);
@@ -110,23 +83,46 @@ static int jadard_prepare(struct drm_panel *panel)
 	if (ret)
 		return ret;
 
-	gpiod_set_value(jadard->reset, 1);
+	gpiod_set_value(jadard->reset, 0);
 	msleep(5);
 
-	gpiod_set_value(jadard->reset, 0);
+	gpiod_set_value(jadard->reset, 1);
 	msleep(10);
 
-	gpiod_set_value(jadard->reset, 1);
+	gpiod_set_value(jadard->reset, 0);
 	msleep(120);
 
-	return 0;
+	/*
+	 * The whole sequence goes out here, before the DSI host starts the
+	 * video stream, as it does in mainline since commit 97d1f449c359
+	 * ("drm/panel: jd9365da: Move "exit sleep mode" and "set display on"
+	 * cmds"). Sent from enable() instead, it reaches a panel that is already
+	 * receiving video, and an inMusic Prime 4+ came up with every pixel's
+	 * color channels rotated: red showed as blue, green as red, blue as
+	 * green.
+	 */
+	for (i = 0; i < desc->num_init_cmds; i++) {
+		const struct jadard_init_cmd *cmd = &desc->init_cmds[i];
+
+		ret = mipi_dsi_dcs_write_buffer(dsi, cmd->data, JD9365DA_INIT_CMD_LEN);
+		if (ret < 0)
+			return ret;
+	}
+
+	msleep(120);
+
+	ret = mipi_dsi_dcs_exit_sleep_mode(dsi);
+	if (ret < 0)
+		return ret;
+
+	return mipi_dsi_dcs_set_display_on(dsi);
 }
 
 static int jadard_unprepare(struct drm_panel *panel)
 {
 	struct jadard *jadard = panel_to_jadard(panel);
 
-	gpiod_set_value(jadard->reset, 1);
+	gpiod_set_value(jadard->reset, 0);
 	msleep(120);
 
 	regulator_disable(jadard->vdd);
@@ -159,12 +155,19 @@ static int jadard_get_modes(struct drm_panel *panel,
 	return 1;
 }
 
+static enum drm_panel_orientation jadard_panel_get_orientation(struct drm_panel *panel)
+{
+	struct jadard *jadard = panel_to_jadard(panel);
+
+	return jadard->orientation;
+}
+
 static const struct drm_panel_funcs jadard_funcs = {
 	.disable = jadard_disable,
 	.unprepare = jadard_unprepare,
 	.prepare = jadard_prepare,
-	.enable = jadard_enable,
 	.get_modes = jadard_get_modes,
+	.get_orientation = jadard_panel_get_orientation,
 };
 
 static const struct jadard_init_cmd radxa_display_8hd_ad002_init_cmds[] = {
@@ -584,6 +587,861 @@ static const struct jadard_panel_desc cz101b4001_desc = {
 	.num_init_cmds = ARRAY_SIZE(cz101b4001_init_cmds),
 };
 
