From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Corrales <deathcamel58@gmail.com>
Date: Tue, 6 Oct 2026 11:41:27 -0400
Subject: [PATCH] drm/panel: add a Himax HX8260 panel driver

Add a driver for the 800x1280 MIPI-DSI panels inMusic builds on a Himax
controller: the URT UMO-P080MD-T fitted to the Denon DJ SC6000, and the
URT UMO-9138MD-8T. Nothing in-tree drives them, and without a drm_panel
the whole display pipeline stays down: rockchip-drm is component-based
and will not finish binding until every component registers.

The controller is identified the way the vendor bootloader identifies
it: write B0 00, read FC/FD/FE, and require FC == 0x82 and FD == 0x60.
Himax parts report their product number there - an HX8279-D answers
82 79 - so this is taken to be an HX8260. That is inferred from the ID
scheme; there is no HX8260 datasheet to hand. Its register map behaves
like the HX8279-D's, B0 selecting a page.

Both panels get the 79-write init sequence every vendor bootloader since
2024 sends them. It is byte-identical between the two and across the 19
builds that carry it; older builds sent the P080MD a 95-write sequence,
which the vendor has since replaced. The mode was read field for field
off the running vendor kernel with modetest:

  800x1280 60.06  800 877 901 925  1280 1298 1302 1314  73000

and matches the bootloader's timing for both panels. Lanes, format and
DSI mode flags (4, RGB888, VIDEO | SYNC_PULSE | LPM) are the vendor
kernel driver's.

Upstream-Status: Inappropriate [vendor board support]
---
 drivers/gpu/drm/panel/Kconfig              |  12 +
 drivers/gpu/drm/panel/Makefile             |   1 +
 drivers/gpu/drm/panel/panel-himax-hx8260.c | 448 +++++++++++++++++++++
 3 files changed, 461 insertions(+)
 create mode 100644 drivers/gpu/drm/panel/panel-himax-hx8260.c

diff --git a/drivers/gpu/drm/panel/Kconfig b/drivers/gpu/drm/panel/Kconfig
index 3a2f4a9..c529d71 100644
--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -162,6 +162,18 @@ config DRM_PANEL_FEIYANG_FY07024DI26A30D
 	  Say Y if you want to enable support for panels based on the
 	  Feiyang FY07024DI26A30-D MIPI-DSI interface.
 
+config DRM_PANEL_HIMAX_HX8260
+	tristate "Himax HX8260 MIPI-DSI panels"
+	depends on OF
+	depends on DRM_MIPI_DSI
+	depends on BACKLIGHT_CLASS_DEVICE
+	help
+	  Say Y here to support the 800x1280 MIPI-DSI panels built on the
+	  Himax HX8260 controller that are fitted to inMusic AZ01 boards,
+	  such as the URT UMO-P080MD-T in the Denon DJ SC6000.
+
+	  If M is selected the module will be called panel-himax-hx8260.
+
 config DRM_PANEL_HIMAX_HX8394
 	tristate "HIMAX HX8394 MIPI-DSI LCD panels"
 	depends on OF
diff --git a/drivers/gpu/drm/panel/Makefile b/drivers/gpu/drm/panel/Makefile
index 433e93d..35667ba 100644
--- a/drivers/gpu/drm/panel/Makefile
+++ b/drivers/gpu/drm/panel/Makefile
@@ -14,6 +14,7 @@ obj-$(CONFIG_DRM_PANEL_EBBG_FT8719) += panel-ebbg-ft8719.o
 obj-$(CONFIG_DRM_PANEL_ELIDA_KD35T133) += panel-elida-kd35t133.o
 obj-$(CONFIG_DRM_PANEL_FEIXIN_K101_IM2BA02) += panel-feixin-k101-im2ba02.o
 obj-$(CONFIG_DRM_PANEL_FEIYANG_FY07024DI26A30D) += panel-feiyang-fy07024di26a30d.o
+obj-$(CONFIG_DRM_PANEL_HIMAX_HX8260) += panel-himax-hx8260.o
 obj-$(CONFIG_DRM_PANEL_HIMAX_HX8394) += panel-himax-hx8394.o
 obj-$(CONFIG_DRM_PANEL_ILITEK_IL9322) += panel-ilitek-ili9322.o
 obj-$(CONFIG_DRM_PANEL_ILITEK_ILI9341) += panel-ilitek-ili9341.o
diff --git a/drivers/gpu/drm/panel/panel-himax-hx8260.c b/drivers/gpu/drm/panel/panel-himax-hx8260.c
new file mode 100644
index 0000000..9b9d1bb
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-himax-hx8260.c
@@ -0,0 +1,448 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Himax HX8260 MIPI-DSI panels, as fitted to inMusic AZ01 boards (the
+ * Denon DJ SC6000 among them).
+ *
+ * The controller is identified the way the vendor u-boot identifies it: its
+ * panel autodetect writes B0 00, reads registers FC/FD/FE and accepts the
+ * panel only if FC == 0x82 and FD == 0x60. Himax parts report their product
+ * number there - an HX8279-D answers 82 79 - so this is taken to be an
+ * HX8260. That is an inference from the ID scheme; no HX8260 datasheet was
+ * available. The register map behaves like the HX8279-D's: B0 selects a page
+ * and everything else is a one-parameter DCS write in the B1-DD range.
+ *
+ * The mode was read field for field off the running vendor kernel with
+ * modetest:
+ *
+ *   800x1280 60.06  800 877 901 925  1280 1298 1302 1314  73000  preferred
+ *
+ * and the pixel clock independently confirmed as dclk_vop1 = 73000000.
+ *
+ * The lane count is the one parameter not recoverable from the device tree or
+ * from sysfs on the vendor kernel. Four is the arithmetic fit: 73 MHz x 24bpp
+ * = 1.752 Gbps, so 438 Mbps per lane over four, and four is also what the
+ * vendor kernel's own driver for this panel sets.
+ */
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+
+struct hx8260_desc;
+
+struct hx8260 {
+	struct drm_panel panel;
+	const struct hx8260_desc *desc;
+	struct mipi_dsi_device *dsi;
+	struct gpio_desc *reset;
+	enum drm_panel_orientation orientation;
+	bool prepared;
+};
+
+static inline struct hx8260 *to_hx8260(struct drm_panel *panel)
+{
+	return container_of(panel, struct hx8260, panel);
+}
+
+/*
+ * u-boot carries this display_timing for every panel the driver handles, at
+ * pixelclock 72927000. The 73000 below is the same mode rounded, and is what
+ * the vendor kernel runs.
+ */
+static const struct drm_display_mode urt_umo_mode = {
+	/*
+	 * 73000, not u-boot's 72927. Read straight out of the vendor kernel's
+	 * drm_display_mode for this panel (clock 0x00011d28, 800/877/901/925,
+	 * 1280/1298/1302/1314, flags 0). dw-mipi-dsi derives the PHY lane rate
+	 * and its PLL dividers from mode->clock, so even a 0.1% difference can
+	 * select a divider that will not lock - which presents as a configured
+	 * panel that never produces a vblank.
+	 */
+	.clock		= 73000,
+	.hdisplay	= 800,
+	.hsync_start	= 877,
+	.hsync_end	= 901,
+	.htotal		= 925,
+	.vdisplay	= 1280,
+	.vsync_start	= 1298,
+	.vsync_end	= 1302,
+	.vtotal		= 1314,
+	.width_mm	= 94,
+	.height_mm	= 151,
+	.type		= DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+};
+
+/*
+ * One DCS write of one parameter. Writing B0 selects the register page the
+ * writes after it land in.
+ */
+struct hx8260_init_cmd {
+	u8 cmd;
+	u8 param;
+};
+
+struct hx8260_desc {
+	const struct hx8260_init_cmd *cmds;
+	unsigned int ncmds;
+	const struct drm_display_mode *mode;
+};
+
+/*
+ * The sequence every vendor u-boot since 2024 sends to both of these panels:
+ * 79 writes, byte-identical between urt,umo-p080md-t and urt,umo-9138md-8t,
+ * and identical across the 19 builds that carry them. Older builds sent the
+ * p080md a 95-write sequence instead; the vendor replaced it, and this is the
+ * replacement. No HX8260 datasheet was available, so the registers are not
+ * annotated: B0 selects the page, and the rest is the vendor's.
+ */
+static const struct hx8260_init_cmd urt_umo_init[] = {
+	/* page 0 */
+	{ 0xb0, 0x00 },
+	{ 0xb1, 0x51 },
+	{ 0xb2, 0x4b },
+	{ 0xb3, 0x48 },
+	{ 0xba, 0xab },
+	{ 0xbb, 0x68 },
+	{ 0xbe, 0x32 },
+	{ 0xbf, 0x14 },
+	{ 0xc4, 0x10 },
+	{ 0xc6, 0x10 },
+	{ 0xc8, 0x00 },
+
+	/* page 2 */
+	{ 0xb0, 0x02 },
+	{ 0xb1, 0x25 },
+	{ 0xb2, 0x00 },
+	{ 0xb3, 0x11 },
+	{ 0xb4, 0x12 },
+	{ 0xb5, 0x05 },
+	{ 0xb6, 0x07 },
+	{ 0xb7, 0x09 },
+	{ 0xb8, 0x0b },
+	{ 0xb9, 0x01 },
+	{ 0xba, 0x00 },
+	{ 0xbb, 0x00 },
+	{ 0xbc, 0x00 },
+	{ 0xbd, 0x00 },
+	{ 0xbe, 0x00 },
+	{ 0xbf, 0x00 },
+	{ 0xc0, 0x0e },
+	{ 0xc1, 0x00 },
+	{ 0xc2, 0x00 },
+	{ 0xc3, 0x00 },
+	{ 0xc4, 0x00 },
+	{ 0xc5, 0x00 },
+	{ 0xc6, 0x00 },
+	{ 0xc7, 0x25 },
+	{ 0xc8, 0x00 },
+	{ 0xc9, 0x11 },
+	{ 0xca, 0x12 },
+	{ 0xcb, 0x06 },
+	{ 0xcc, 0x08 },
+	{ 0xcd, 0x0a },
+	{ 0xce, 0x0c },
+	{ 0xcf, 0x02 },
+	{ 0xd0, 0x00 },
+	{ 0xd1, 0x00 },
+	{ 0xd2, 0x00 },
+	{ 0xd3, 0x00 },
+	{ 0xd4, 0x00 },
+	{ 0xd5, 0x00 },
+	{ 0xd6, 0x0f },
+	{ 0xd7, 0x00 },
+	{ 0xd8, 0x00 },
+	{ 0xd9, 0x00 },
+	{ 0xda, 0x00 },
+	{ 0xdb, 0x00 },
+	{ 0xdc, 0x00 },
+	{ 0xdd, 0x00 },
+
+	/* page 3 */
+	{ 0xb0, 0x03 },
+	{ 0xb2, 0x01 },
+	{ 0xb6, 0x1a },
+	{ 0xb7, 0x00 },
+	{ 0xb8, 0x00 },
+	{ 0xb9, 0x00 },
+	{ 0xba, 0x00 },
+	{ 0xbd, 0x00 },
+	{ 0xbe, 0x00 },
+	{ 0xc3, 0x03 },
+	{ 0xc4, 0x04 },
+	{ 0xc5, 0x03 },
+	{ 0xc6, 0x02 },
+	{ 0xc7, 0x40 },
+	{ 0xca, 0x3c },
+	{ 0xcb, 0x14 },
+	{ 0xcc, 0x00 },
+	{ 0xcf, 0x00 },
+	{ 0xd0, 0x00 },
+	{ 0xd2, 0x03 },
+	{ 0xd4, 0x00 },
+	{ 0xd5, 0x01 },
+};
+
+/*
+ * One descriptor for both. The vendor's u-boot drives them with one driver
+ * and one display_timing, and its kernel binds both to one driver too.
+ */
+static const struct hx8260_desc urt_umo_desc = {
+	.cmds = urt_umo_init, .ncmds = ARRAY_SIZE(urt_umo_init),
+	.mode = &urt_umo_mode,
+};
+
+static int hx8260_prepare(struct drm_panel *panel)
+{
+	struct hx8260 *p = to_hx8260(panel);
+	size_t i;
+	int ret;
+
+	if (p->prepared)
+		return 0;
+
+	/*
+	 * vcc-mipi is regulator-boot-on but NOT regulator-always-on. The supply
+	 * is taken once at probe and held for the life of the device: dropping
+	 * it in unprepare() left the display unable to come back from a blank,
+	 * backlight on and no picture.
+	 *
+	 * The reset pulse must end LOW. With it low the display works, with it
+	 * high the panel sits in reset and the screen is black - measured both
+	 * ways. u-boot is no guide here: its panel driver drives a line it
+	 * requests as "enable-gpios", and this node has only reset-gpios.
+	 */
+	msleep(15);
+	gpiod_set_value_cansleep(p->reset, 1);	/* assert */
+	msleep(20);
+	gpiod_set_value_cansleep(p->reset, 0);	/* release - working state */
+	msleep(20);
+
+	for (i = 0; i < p->desc->ncmds; i++) {
+		const struct hx8260_init_cmd *c = &p->desc->cmds[i];
+
+		ret = mipi_dsi_dcs_write(p->dsi, c->cmd, &c->param, 1);
+		if (ret < 0)
+			return dev_err_probe(&p->dsi->dev, ret,
+					     "init command %zu failed\n", i);
+	}
+
+	ret = mipi_dsi_dcs_exit_sleep_mode(p->dsi);
+	if (ret)
+		return ret;
+
+	p->prepared = true;
+	return 0;
+}
+
+static int hx8260_enable(struct drm_panel *panel)
+{
+	struct hx8260 *p = to_hx8260(panel);
+	int ret;
+
+	/*
+	 * set_display_on belongs here, not in prepare(): DRM runs
+	 * prepare() -> video stream -> enable(), so lighting the panel from
+	 * prepare() scans out unsettled GRAM.
+	 *
+	 * 120 ms is the controller's sleep-out settling time. The 300 ms below
+	 * is a latency-vs-polish knob: drm_panel_enable() turns the backlight on
+	 * as soon as this returns, so the wait is spent with the panel dark.
+	 */
+	msleep(120);
+
+	ret = mipi_dsi_dcs_set_display_on(p->dsi);
+	if (ret)
+		return ret;
+
+	msleep(300);
+
+	return 0;
+}
+
+static int hx8260_disable(struct drm_panel *panel)
+{
+	struct hx8260 *p = to_hx8260(panel);
+	int ret;
+
+	/*
+	 * Blank the output, then put the panel to sleep while the DSI link is
+	 * still up. Without the sleep-in the panel was left awake when
+	 * dw-mipi-dsi stopped the DSI clock, and its gate driver came back wrong
+	 * on about half of all resumes: a dark band a few pixels wide down one
+	 * edge. This belongs in disable(), not unprepare() - the DSI host's
+	 * post_disable runs first, so a command sent from unprepare() can reach
+	 * an already dead link.
+	 *
+	 * 120 ms is the DCS sleep-in settling time.
+	 *
+	 * This cut the band from about one wake in two to one in ten. The
+	 * remainder is not in this sequence: a longer post-reset settle and a
+	 * gap between the two commands were both measured at 3/30, unchanged.
+	 */
+	ret = mipi_dsi_dcs_set_display_off(p->dsi);
+	if (ret)
+		return ret;
+
+	ret = mipi_dsi_dcs_enter_sleep_mode(p->dsi);
+	if (ret)
+		return ret;
+
+	msleep(120);
+	return 0;
+}
+
+static int hx8260_unprepare(struct drm_panel *panel)
+{
+	struct hx8260 *p = to_hx8260(panel);
+
+	/* See hx8260_prepare(): the supply is held, never dropped. */
+	p->prepared = false;
+	return 0;
+}
+
+static int hx8260_get_modes(struct drm_panel *panel,
+			      struct drm_connector *connector)
+{
+	struct hx8260 *p = to_hx8260(panel);
+	struct drm_display_mode *mode;
+
+	mode = drm_mode_duplicate(connector->dev, p->desc->mode);
+	if (!mode)
+		return -ENOMEM;
+
+	drm_mode_set_name(mode);
+	drm_mode_probed_add(connector, mode);
+
+	connector->display_info.width_mm = p->desc->mode->width_mm;
+	connector->display_info.height_mm = p->desc->mode->height_mm;
+	connector->display_info.bpc = 8;
+
+	return 1;
+}
+
+static enum drm_panel_orientation hx8260_get_orientation(struct drm_panel *panel)
+{
+	return to_hx8260(panel)->orientation;
+}
+
+static const struct drm_panel_funcs hx8260_funcs = {
+	.prepare	= hx8260_prepare,
+	.enable		= hx8260_enable,
+	.disable	= hx8260_disable,
+	.unprepare	= hx8260_unprepare,
+	.get_modes	= hx8260_get_modes,
+	.get_orientation = hx8260_get_orientation,
+};
+
+static int hx8260_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct hx8260 *p;
+	int ret;
+
+	p = devm_kzalloc(dev, sizeof(*p), GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+
+	p->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, p);
+
+	/*
+	 * Enabled here and released only when the device goes away. See
+	 * hx8260_prepare() for why this must not be tied to the prepare and
+	 * unprepare callbacks.
+	 */
+	ret = devm_regulator_get_enable(dev, "power");
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to enable the panel supply\n");
+
+	p->reset = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(p->reset))
+		return dev_err_probe(dev, PTR_ERR(p->reset),
+				     "failed to get the reset gpio\n");
+
+	ret = of_drm_get_panel_orientation(dev->of_node, &p->orientation);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to read the rotation\n");
+
+	p->desc = of_device_get_match_data(dev);
+	if (!p->desc)
+		return dev_err_probe(dev, -EINVAL, "no match data for this compatible\n");
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	/*
+	 * Sync-pulse, not burst. Read out of the vendor kernel's own panel
+	 * driver, whose probe opens with
+	 *
+	 *   mov  r3, #4      str r3, [r0, #0x214]   dsi->lanes = 4
+	 *   mov  r3, #0      str r3, [r0, #0x218]   dsi->format = RGB888
+	 *   movw r3, #0x805  str r3, [r0, #0x21c]   dsi->mode_flags
+	 *
+	 * and 0x805 is VIDEO | VIDEO_SYNC_PULSE | LPM. We had VIDEO_BURST,
+	 * which the Prime GO's panel tolerates but the SC6000's does not: the
+	 * link comes up, the panel is configured, and the VOP still never sees
+	 * a vblank, so every atomic commit ends in "flip_done timed out".
+	 */
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_SYNC_PULSE |
+			  MIPI_DSI_MODE_LPM;
+
+	drm_panel_init(&p->panel, dev, &hx8260_funcs,
+		       DRM_MODE_CONNECTOR_DSI);
+
+	ret = drm_panel_of_backlight(&p->panel);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get the backlight\n");
+
+	drm_panel_add(&p->panel);
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret) {
+		drm_panel_remove(&p->panel);
+		return dev_err_probe(dev, ret, "failed to attach to the DSI host\n");
+	}
+
+	dev_dbg(dev, "registered, %u-command init sequence\n", p->desc->ncmds);
+	return 0;
+}
+
+static void hx8260_remove(struct mipi_dsi_device *dsi)
+{
+	struct hx8260 *p = mipi_dsi_get_drvdata(dsi);
+
+	mipi_dsi_detach(dsi);
+	drm_panel_remove(&p->panel);
+}
+
+/*
+ * You cannot tell from a device tree which panel a board actually has: u-boot
+ * probes the panel at boot and rewrites the compatible to whatever it finds
+ * ("Detected panel: %s"), so every panel it can emit needs a driver. This one
+ * takes the HX8260-based panels.
+ */
+static const struct of_device_id hx8260_of_match[] = {
+	{ .compatible = "urt,umo-p080md-t",  .data = &urt_umo_desc },
+	{ .compatible = "urt,umo-9138md-8t", .data = &urt_umo_desc },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, hx8260_of_match);
+
+static struct mipi_dsi_driver hx8260_driver = {
+	.probe = hx8260_probe,
+	.remove = hx8260_remove,
+	.driver = {
+		.name = "panel-himax-hx8260",
+		.of_match_table = hx8260_of_match,
+	},
+};
+module_mipi_dsi_driver(hx8260_driver);
+
+MODULE_DESCRIPTION("Himax HX8260 MIPI-DSI panel driver");
+MODULE_LICENSE("GPL");
-- 
2.43.0

