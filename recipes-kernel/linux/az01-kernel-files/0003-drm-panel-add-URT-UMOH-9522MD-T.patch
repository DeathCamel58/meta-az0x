+static const struct umoh9522_desc p080md_desc = {
+	.cmds = p080md_init, .ncmds = ARRAY_SIZE(p080md_init),
+	.mode = &p080md_mode, .paged = false,
+	/*
+	 * Confirmed against the vendor kernel's own driver for this panel: the
+	 * 95 pairs above are identical to its table, byte for byte, and its
+	 * probe sets the same lanes/format/mode_flags we now use. So send it.
+	 */
+};
+
+static const struct umoh9522_desc u9399md_desc = {
+	.cmds = u9399md_init, .ncmds = ARRAY_SIZE(u9399md_init),
+	.mode = &u9399md_mode, .paged = false,
+};
+
+/*
+ * urt,umo-9399md-4t. Not the same panel as -1t: a different 210-entry register
+ * list, and it shares umoh9522_mode rather than u9399md_mode (u-boot gives both
+ * 800/877/901/925 1280/1292/1296/1314, identical to the Prime GO's panel).
+ *
+ * Added because a JC11S was observed booting with exactly this compatible in
+ * its *runtime* device tree, while the shipped tree for that board says
+ * urt,umo-p080md-t - u-boot rewrote it. So -4t is a value the bootloader
+ * really emits and nothing of ours bound it.
+ */
+static const struct umoh9522_desc u9399md4t_desc = {
+	.cmds = u9399md4t_init, .ncmds = ARRAY_SIZE(u9399md4t_init),
+	.mode = &umoh9522_mode, .paged = false, .inherit_bootloader = true,
+};
+
+static int umoh9522_send(struct mipi_dsi_device *dsi,
+			 const struct umoh9522_init_cmd *c)
+{
+	/* Page select is the ILI9881C magic prefix plus the bank number. */
+	const u8 page[4] = { 0xff, 0x98, 0x81, c->cmd };
+	int ret;
+
+	if (c->type == UMOH_PAGE)
+		ret = mipi_dsi_dcs_write_buffer(dsi, page, sizeof(page));
+	else
+		ret = mipi_dsi_dcs_write(dsi, c->cmd, &c->param, 1);
+
+	return ret < 0 ? ret : 0;
+}
+
+static int umoh9522_prepare(struct drm_panel *panel)
+{
+	struct umoh9522 *p = to_umoh9522(panel);
+	size_t i;
+	int ret;
+
+	if (p->prepared)
+		return 0;
+
+	/*
+	 * vcc-mipi is regulator-boot-on but NOT regulator-always-on. The supply
+	 * is taken once at probe and held for the life of the device: dropping
+	 * it in unprepare() left the display unable to come back from a blank,
+	 * backlight on and no picture.
+	 *
+	 * The reset pulse must end LOW. With it low the display works, with it
+	 * high the panel sits in reset and the screen is black - measured both
+	 * ways. u-boot is no guide here: its panel driver drives a line it
+	 * requests as "enable-gpios", and this node has only reset-gpios.
+	 */
+	if (!p->desc->inherit_bootloader) {
+		msleep(15);
+		gpiod_set_value_cansleep(p->reset, 1);	/* assert */
+		msleep(20);
+		gpiod_set_value_cansleep(p->reset, 0);	/* release - working state */
+		msleep(20);
+
+		for (i = 0; i < p->desc->ncmds; i++) {
+			ret = umoh9522_send(p->dsi, &p->desc->cmds[i]);
+			if (ret)
+				return dev_err_probe(&p->dsi->dev, ret,
+						     "init command %zu failed\n", i);
+		}
+
+		/*
+		 * The page-0 select and set_tear_on belong to the ILI9881C-class
+		 * panels only. Sending 0x35 to a register-list panel that does
+		 * not implement it makes prepare() fail here.
+		 */
+		ret = 0;
+		if (p->desc->paged) {
+			ret = umoh9522_send(p->dsi,
+					    &(struct umoh9522_init_cmd){ UMOH_PAGE, 0x00, 0x00 });
+			if (!ret)
+				ret = mipi_dsi_dcs_set_tear_on(p->dsi,
+							       MIPI_DSI_DCS_TEAR_MODE_VBLANK);
+		}
+		if (ret)
+			return ret;
+	}
+
+	/*
+	 * Wake the panel on every path, including inherit_bootloader. disable()
+	 * sleeps it unconditionally, so skipping this would leave a panel that
+	 * inherits u-boot's init asleep after its first blank - set_display_on
+	 * does nothing to a sleeping panel, and the screen stays black.
+	 */
+	ret = mipi_dsi_dcs_exit_sleep_mode(p->dsi);
+	if (ret)
+		return ret;
+
+	p->prepared = true;
+	return 0;
+}
+
+static int umoh9522_enable(struct drm_panel *panel)
+{
+	struct umoh9522 *p = to_umoh9522(panel);
+	int ret;
+
+	/*
+	 * set_display_on belongs here, not in prepare(): DRM runs
+	 * prepare() -> video stream -> enable(), so lighting the panel from
+	 * prepare() scans out unsettled GRAM. Mainline panel-ilitek-ili9881c.c,
+	 * the same controller family, splits it the same way.
+	 *
+	 * 120 ms is the controller's sleep-out settling time. The 300 ms below
+	 * is a latency-vs-polish knob: drm_panel_enable() turns the backlight on
+	 * as soon as this returns, so the wait is spent with the panel dark.
+	 */
+	msleep(120);
+
+	ret = mipi_dsi_dcs_set_display_on(p->dsi);
+	if (ret)
+		return ret;
+
+	msleep(300);
+
+	return 0;
+}
+
+static int umoh9522_disable(struct drm_panel *panel)
+{
+	struct umoh9522 *p = to_umoh9522(panel);
+	int ret;
+
+	/*
+	 * Blank the output, then put the panel to sleep while the DSI link is
+	 * still up. Without the sleep-in the panel was left awake when
+	 * dw-mipi-dsi stopped the DSI clock, and its gate driver came back wrong
+	 * on about half of all resumes: a dark band a few pixels wide down one
+	 * edge. This belongs in disable(), not unprepare() - the DSI host's
+	 * post_disable runs first, so a command sent from unprepare() can reach
+	 * an already dead link.
+	 *
+	 * 120 ms is the DCS sleep-in settling time.
+	 *
+	 * This cut the band from about one wake in two to one in ten. The
+	 * remainder is not in this sequence: a longer post-reset settle and a
+	 * gap between the two commands were both measured at 3/30, unchanged.
+	 */
+	ret = mipi_dsi_dcs_set_display_off(p->dsi);
+	if (ret)
+		return ret;
+
+	ret = mipi_dsi_dcs_enter_sleep_mode(p->dsi);
+	if (ret)
+		return ret;
+
+	msleep(120);
+	return 0;
+}
+
+static int umoh9522_unprepare(struct drm_panel *panel)
+{
+	struct umoh9522 *p = to_umoh9522(panel);
+
+	/* See umoh9522_prepare(): the supply is held, never dropped. */
+	p->prepared = false;
+	return 0;
+}
+
+static int umoh9522_get_modes(struct drm_panel *panel,
+			      struct drm_connector *connector)
+{
+	struct umoh9522 *p = to_umoh9522(panel);
+	struct drm_display_mode *mode;
+
+	mode = drm_mode_duplicate(connector->dev, p->desc->mode);
+	if (!mode)
+		return -ENOMEM;
+
+	drm_mode_set_name(mode);
+	drm_mode_probed_add(connector, mode);
+
+	connector->display_info.width_mm = p->desc->mode->width_mm;
+	connector->display_info.height_mm = p->desc->mode->height_mm;
+	connector->display_info.bpc = 8;
+
+	return 1;
+}
+
+static enum drm_panel_orientation umoh9522_get_orientation(struct drm_panel *panel)
+{
+	return to_umoh9522(panel)->orientation;
+}
+
+static const struct drm_panel_funcs umoh9522_funcs = {
+	.prepare	= umoh9522_prepare,
+	.enable		= umoh9522_enable,
+	.disable	= umoh9522_disable,
+	.unprepare	= umoh9522_unprepare,
+	.get_modes	= umoh9522_get_modes,
+	.get_orientation = umoh9522_get_orientation,
+};
+
+static int umoh9522_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct umoh9522 *p;
+	int ret;
+
+	p = devm_kzalloc(dev, sizeof(*p), GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+
+	p->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, p);
+
+	/*
+	 * Enabled here and released only when the device goes away. See
+	 * umoh9522_prepare() for why this must not be tied to the prepare and
+	 * unprepare callbacks.
+	 */
+	ret = devm_regulator_get_enable(dev, "power");
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to enable the panel supply\n");
+
+	/*
+	 * Claimed as ASIS so that requesting it does not drive it, which would
+	 * reset the panel out from under u-boot's initialisation.
+	 */
+	p->reset = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(p->reset))
+		return dev_err_probe(dev, PTR_ERR(p->reset),
+				     "failed to get the reset gpio\n");
+
+
+	ret = of_drm_get_panel_orientation(dev->of_node, &p->orientation);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to read the rotation\n");
+
+	p->desc = of_device_get_match_data(dev);
+	if (!p->desc)
+		return dev_err_probe(dev, -EINVAL, "no match data for this compatible\n");
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	/*
+	 * Sync-pulse, not burst. Read out of the vendor kernel's own panel
+	 * driver, whose probe opens with
+	 *
+	 *   mov  r3, #4      str r3, [r0, #0x214]   dsi->lanes = 4
+	 *   mov  r3, #0      str r3, [r0, #0x218]   dsi->format = RGB888
+	 *   movw r3, #0x805  str r3, [r0, #0x21c]   dsi->mode_flags
+	 *
+	 * and 0x805 is VIDEO | VIDEO_SYNC_PULSE | LPM. We had VIDEO_BURST,
+	 * which the Prime GO's panel tolerates but the SC6000's does not: the
+	 * link comes up, the panel is configured, and the VOP still never sees
+	 * a vblank, so every atomic commit ends in "flip_done timed out".
+	 */
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_SYNC_PULSE |
+			  MIPI_DSI_MODE_LPM;
+
+	drm_panel_init(&p->panel, dev, &umoh9522_funcs,
+		       DRM_MODE_CONNECTOR_DSI);
+
+	ret = drm_panel_of_backlight(&p->panel);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get the backlight\n");
+
+	drm_panel_add(&p->panel);
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret) {
+		drm_panel_remove(&p->panel);
+		return dev_err_probe(dev, ret, "failed to attach to the DSI host\n");
+	}
+
+	dev_dbg(dev, "registered, %u-command init sequence\n", p->desc->ncmds);
+	return 0;
+}
+
+static void umoh9522_remove(struct mipi_dsi_device *dsi)
+{
+	struct umoh9522 *p = mipi_dsi_get_drvdata(dsi);
+
+	mipi_dsi_detach(dsi);
+	drm_panel_remove(&p->panel);
+}
+
+/*
+ * You cannot tell from a device tree which panel a board actually has: u-boot
+ * probes the panel at boot and rewrites the compatible to whatever it finds
+ * ("Detected panel: %s"). 24 of our boards ship a DT saying urt,umo-p076md-t,
+ * a name u-boot has no sequence for at all - it is the template, not the
+ * fitted part. So bind every compatible u-boot is able to emit.
+ */
+static const struct of_device_id umoh9522_of_match[] = {
+	{ .compatible = "urt,umo-p080md-t",             .data = &p080md_desc },
+	{ .compatible = "urt,umo-9399md-1t",            .data = &u9399md_desc },
+	{ .compatible = "urt,umo-9399md-4t",            .data = &u9399md4t_desc },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, umoh9522_of_match);
+
+static struct mipi_dsi_driver umoh9522_driver = {
+	.probe = umoh9522_probe,
+	.remove = umoh9522_remove,
+	.driver = {
+		.name = "panel-urt-umoh-9522md-t",
+		.of_match_table = umoh9522_of_match,
+	},
+};
+module_mipi_dsi_driver(umoh9522_driver);
+
+MODULE_DESCRIPTION("URT UMOH-9522MD-T DSI panel");
+MODULE_LICENSE("GPL");
