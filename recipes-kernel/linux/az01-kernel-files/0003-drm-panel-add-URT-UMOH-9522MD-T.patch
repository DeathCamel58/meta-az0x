+/*
+ * Initialisation sequence, recovered from the vendor's u-boot
+ * (drivers/video/urt_umoh_9522md_t_panel.c in U-Boot 2016.05-inmusic-20230621,
+ * dumped off the eMMC "uboot" partition of a Prime Go).
+ *
+ * The controller behaves like an ILI9881C: register banks are selected with a
+ * four-byte 0xFF 0x98 0x81 <page> long write, and everything else is a DCS
+ * short write of one parameter. The vendor table is 194 entries - three page
+ * selects (3, 4, 1) and 191 register writes - followed by a fixed tail.
+ *
+ * Every byte here is the vendor's. Nothing was invented or tuned.
+ */
+/*
+ * u-boot carries a display_timing for every panel it can detect. All four
+ * ILI9881C-class panels share these timings exactly - they are alternate
+ * vendors for the same product and have to be interchangeable, which is why
+ * u-boot is willing to autodetect between them. The two register-list panels
+ * below differ and get their own modes.
+ *
+ * (u-boot says pixelclock 72927000; the 73000 above is the same mode rounded,
+ * and is what has been running on hardware, so it is left alone.)
+ */
+static const struct drm_display_mode p080md_mode = {
+	/*
+	 * 73000, not u-boot's 72927. Read straight out of the vendor kernel's
+	 * drm_display_mode for this panel (clock 0x00011d28, 800/877/901/925,
+	 * 1280/1298/1302/1314, flags 0). dw-mipi-dsi derives the PHY lane rate
+	 * and its PLL dividers from mode->clock, so even a 0.1% difference can
+	 * select a divider that will not lock - which presents as a configured
+	 * panel that never produces a vblank.
+	 */
+	.clock		= 73000,
+	.hdisplay	= 800,
+	.hsync_start	= 877,
+	.hsync_end	= 901,
+	.htotal		= 925,
+	.vdisplay	= 1280,
+	.vsync_start	= 1298,
+	.vsync_end	= 1302,
+	.vtotal		= 1314,
+	.width_mm	= 94,
+	.height_mm	= 151,
+	.type		= DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+};
+
+static const struct drm_display_mode u9399md_mode = {
