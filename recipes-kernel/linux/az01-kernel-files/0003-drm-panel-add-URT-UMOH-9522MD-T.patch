+	.type		= DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+};
+
+#define UMOH_PAGE	0
+#define UMOH_WRITE	1
+
+struct umoh9522_init_cmd {
+	u8 type;
+	u8 cmd;
+	u8 param;
+};
+
+/*
+ * paged == this is an ILI9881C-class part, whose registers live in banks
+ * selected by an FF 98 81 <page> long write. Those panels want a final
+ * "back to page 0" before the sleep-out; the register-list panels are a
+ * different controller and must NOT be sent that sequence.
+ */
+struct umoh9522_desc {
+	const struct umoh9522_init_cmd *cmds;
+	unsigned int ncmds;
+	const struct drm_display_mode *mode;
+	bool paged;
+	/*
+	 * Leave the panel exactly as the bootloader set it up: no reset pulse,
+	 * no register upload. Set for panels whose table we have not verified
+	 * on real hardware - sending a wrong sequence to a panel u-boot has
+	 * already configured turns a working display black.
+	 */
+	bool inherit_bootloader;
+};
