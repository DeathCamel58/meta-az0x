+++ b/arch/arm/boot/dts/rockchip/rk3288-az01.dtsi
@@ -0,0 +1,975 @@
+// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
+/*
+ * inMusic AZ01 common platform description.
+ *
+ * Inferred from 35 vendor device trees: this file holds only what is
+ * identical on all 35 boards -- 246 nodes in total.
+ *
+ * Self-contained by design.  Including mainline rk3288.dtsi is NOT correct here:
+ * the vendor tree descends from a downstream Rockchip dtsi that names the same
+ * hardware differently (dwmmc@ff0c0000 vs mmc@ff0c0000, mipi@ff960000 vs
+ * dsi@ff960000), so an #include duplicates nodes instead of overriding them.
+ * For reference, 146 of these 246 nodes ARE byte-identical to
+ * mainline rk3288.dtsi, and 16 more differ only in retuned properties.
+ *
+ * Phandle references use dtc path syntax (&{/foo}) because the decompiled
+ * source carries no labels.
+ */
+
+/ {
+	ac-power {
+		compatible = "inmusic,az01-power";
+		io-channels = <&{/saradc@ff100000} 0x00>;
+	};
+	arm-pmu {
+		compatible = "arm,cortex-a12-pmu";
+		interrupts = <0x00 0x97 0x04 0x00 0x98 0x04 0x00 0x99 0x04 0x00 0x9a 0x04>;
+		interrupt-affinity = <&{/cpus/cpu@500} &{/cpus/cpu@501} &{/cpus/cpu@502} &{/cpus/cpu@503}>;
+	};
+	cpus {
+		#address-cells = <0x01>;
+		#size-cells = <0x00>;
+		enable-method = "rockchip,rk3066-smp";
+		rockchip,pmu = <&{/power-management@ff730000}>;
+	};
+	display-subsystem {
+		compatible = "rockchip,display-subsystem";
+		ports = <&{/vop@ff940000/port} &{/vop@ff930000/port}>;
+		memory-region = <&{/reserved-memory/framebuffer}>;
+	};
+	dp@ff970000 {
+		ports {
+			#address-cells = <0x01>;
+			#size-cells = <0x00>;
+
+			port@0 {
+				reg = <0x00>;
+				#address-cells = <0x01>;
+				#size-cells = <0x00>;
+
