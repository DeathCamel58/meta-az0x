+	#size-cells = <0x02>;
+	compatible = "inmusic,jp11\0inmusic,az01\0rockchip,rk3288-c\0rockchip,rk3288";
+	interrupt-parent = <&{/interrupt-controller@ffc01000}>;
+	inmusic,product-code = "JP11";
+	inmusic,panel-rotation = <0x10e>;
+	model = "Denon DJ Prime GO";
+
+	opp-table-0 {
+		opp-1800000000 {
+			opp-hz = <0x00 0x6b49d200>;
+			opp-microvolt = <0x155cc0>;
+		};
