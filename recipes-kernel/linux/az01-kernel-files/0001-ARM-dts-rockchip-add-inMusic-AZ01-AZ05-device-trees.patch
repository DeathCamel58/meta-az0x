diff --git a/arch/arm/boot/dts/rockchip/rk3288-az01-jp11-fitted.dtsi b/arch/arm/boot/dts/rockchip/rk3288-az01-jp11-fitted.dtsi
new file mode 100644
index 0000000..a88cefd
--- /dev/null
+++ b/arch/arm/boot/dts/rockchip/rk3288-az01-jp11-fitted.dtsi
@@ -0,0 +1,75 @@
+// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
+/*
+ * What u-boot resolves on a JP11 at boot, applied statically.
+ *
+ * The DTB inMusic ships is a TEMPLATE: u-boot edits it before handing it to
+ * the kernel, presumably after probing which parts are actually fitted.
+ * Comparing all 59 status properties live-vs-shipped on a real Prime GO, it
+ * changes exactly these four. Our kernel gets the tree as-is, so without this
+ * overlay the touchscreen and one USB controller are simply dead.
+ *
+ * Measured, not guessed - see docs/az01-hardware-facts.md.
+ *
+ * HAND-MAINTAINED: build-layers.py does not generate this file. If the layered
+ * tree is regenerated, re-add this file and its #include in the board .dts.
+ */
+
+/ {
+	/*
+	 * This unit carries an ILI2117 at 0x26, not the ILI2116 at 0x41 the
+	 * shipped template enables:
+	 *   ili2117 4-0026: ILI2117 vendor 0x00 firmware version 5.0
+	 * Mainline ili210x.c already drives it (ilitek,ili2117 -> ili211x_chip),
+	 * so this needs no vendor driver, only CONFIG_TOUCHSCREEN_ILI210X.
+	 */
+	i2c@ff160000 {
+		ili2116@41 {
+			status = "disabled";
+		};
+
+		ili2117@26 {
+			status = "okay";
+		};
+	};
+
+	/*
+	 * u-boot rewrites the panel compatible too, not just status properties.
+	 * The template names a p076md-t; the panel actually fitted to this unit
+	 * is a umoh-9522md-t, and the vendor kernel binds
+	 * panel-urt-umoh-9522md-t accordingly. Verified by diffing all 137
+	 * compatible properties of the live tree against the template - this is
+	 * the only one that differs.
+	 *
+	 * Note NO vendor DTB in the family declares umoh-9522md-t: 22 boards say
+	 * p076md-t and 9 say p080md-t. So the template records the design intent
+	 * and u-boot records what is physically present.
+	 */
+	mipi@ff960000 {
+		panel@0 {
+			compatible = "urt,umoh-9522md-t";
+		};
+	};
+
+	/* u-boot has already lit the VOP ("enabled by bootloader") and hands
+	 * over its framebuffer reservation. */
+	reserved-memory {
+		framebuffer {
+			status = "okay";
+		};
+	};
+
+	usb@ff580000 {
+		status = "okay";
+	};
+
+	/*
+	 * Measured on this unit rather than left to the driver's defaults:
+	 * the DC jack reads 18.64 V present / 15.82 V absent, and the absent
+	 * reading is the battery terminal, so it climbs with charge. 17.5 V
+	 * clears a full 4S pack (16.8 V) and stays under the adapter.
+	 */
+	ac-power {
+		inmusic,online-threshold-mv = <17500>;
+		inmusic,divider-ratio = <16>;
+	};
+};
