From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: az0x <dev@localhost>
Date: Fri, 18 Sep 2026 12:23:52 -0400
Subject: [PATCH 04/14] ASoC: codecs: add the inMusic AZ0x audio codec

The DAC on inMusic AZ0x boards (Denon DJ, Numark, Rane, Akai on RK3288) has
no control interface at all - no I2C, no SPI, no registers. All it exposes is
a master clock and three GPIOs, so the device tree already describes it
completely and this driver is a DAI plus that GPIO sequencing.

Nothing in-tree fits: the closest, max98357a, drives a single GPIO and has no
clock or reset handling, and the DT form here is not one simple-audio-card can
parse.

The single 44100 rate is measured, not assumed. On a Prime GO running the
vendor kernel, aplay --dump-hw-params reports RATE as the single value 44100
and 48000/88200/96000 are rejected outright; formats are S16/S24/S32_LE and
channels [2 4], the four being a master output plus a headphone output.

Power-on follows the vendor's two paths. On boards whose table entry asks
for it at probe (JP11, JC16) reset is released before the analogue supply is
switched on. Every other board powers on at the first BIAS_STANDBY
transition with the supply on first and reset released second. MCLK starts
last on both paths. Brought up in the probe-time order, an SC6000 (JP13)
drains the I2S FIFO normally but is silent on all four line outputs.

JP13 and JP14 have no entry of their own in the vendor table and fall back to
inmusic,jp07-audio-codec: 44.1-96 kHz, four channels, no capture. Measured on
an SC6000 running the vendor kernel.

Upstream-Status: Inappropriate [vendor board support]
---
 sound/soc/codecs/Kconfig            |   8 +
 sound/soc/codecs/Makefile           |   2 +
 sound/soc/codecs/az0x-audio-codec.c | 301 ++++++++++++++++++++++++++++
 3 files changed, 311 insertions(+)
 create mode 100644 sound/soc/codecs/az0x-audio-codec.c

diff --git a/sound/soc/codecs/Kconfig b/sound/soc/codecs/Kconfig
index 91ac99bc3edb..f5f748719b2e 100644
--- a/sound/soc/codecs/Kconfig
+++ b/sound/soc/codecs/Kconfig
@@ -1334,6 +1334,14 @@ config SND_SOC_MAX98095
 	tristate
 	depends on I2C
 
+config SND_SOC_AZ0X_AUDIO_CODEC
+	tristate "inMusic AZ0x audio codec"
+	depends on GPIOLIB
+	help
+	  Say Y or M here to support the DAC fitted to inMusic AZ0x boards
+	  (Denon DJ, Numark, Rane, Akai on RK3288). It has no control
+	  interface - only a master clock and enable/mute/reset GPIOs.
+
 config SND_SOC_MAX98357A
 	tristate "Maxim MAX98357A CODEC"
 
diff --git a/sound/soc/codecs/Makefile b/sound/soc/codecs/Makefile
index da4077463278..149ccb1d5269 100644
--- a/sound/soc/codecs/Makefile
+++ b/sound/soc/codecs/Makefile
@@ -56,6 +56,7 @@ snd-soc-aw88395-y := aw88395/aw88395.o \
 snd-soc-aw88166-y := aw88166.o
 snd-soc-aw88261-y := aw88261.o
 snd-soc-aw88399-y := aw88399.o
+snd-soc-az0x-audio-codec-y := az0x-audio-codec.o
 snd-soc-bd28623-y := bd28623.o
 snd-soc-bt-sco-y := bt-sco.o
 snd-soc-chv3-codec-y := chv3-codec.o
@@ -488,6 +489,7 @@ obj-$(CONFIG_SND_SOC_AW88395)	+=snd-soc-aw88395.o
 obj-$(CONFIG_SND_SOC_AW88166)	+=snd-soc-aw88166.o
 obj-$(CONFIG_SND_SOC_AW88261)	+=snd-soc-aw88261.o
 obj-$(CONFIG_SND_SOC_AW88399)	+= snd-soc-aw88399.o
+obj-$(CONFIG_SND_SOC_AZ0X_AUDIO_CODEC)	+= snd-soc-az0x-audio-codec.o
 obj-$(CONFIG_SND_SOC_BD28623)	+= snd-soc-bd28623.o
 obj-$(CONFIG_SND_SOC_BT_SCO)	+= snd-soc-bt-sco.o
 obj-$(CONFIG_SND_SOC_CHV3_CODEC) += snd-soc-chv3-codec.o
diff --git a/sound/soc/codecs/az0x-audio-codec.c b/sound/soc/codecs/az0x-audio-codec.c
new file mode 100644
index 000000000000..b89807b898ed
--- /dev/null
+++ b/sound/soc/codecs/az0x-audio-codec.c
@@ -0,0 +1,301 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * ASoC codec driver for the DAC fitted to inMusic AZ0x boards
+ * (Denon DJ, Numark, Rane, Akai; RK3288 "AZ01"/"AZ05" platform).
+ *
+ * The part has no control interface at all - no I2C, no SPI, no registers, and
+ * so no mixer controls either. All it exposes is a master clock and three
+ * GPIOs, which is why the device tree describes it completely:
+ *
+ *	sound-codec {
+ *		compatible = "inmusic,jp11-audio-codec";
+ *		#sound-dai-cells = <0>;
+ *		clocks = <&cru SCLK_I2S0_OUT>;
+ *		enable-gpios = <&gpio2 1 GPIO_ACTIVE_HIGH>;
+ *		mute-gpios   = <&gpio2 2 GPIO_ACTIVE_HIGH>;
+ *		reset-gpios  = <&gpio2 0 GPIO_ACTIVE_LOW>;
+ *	};
+ *
+ * What the device tree does NOT say is the sample rates, channel count and
+ * reset timing, which differ per board. The vendor keeps those in a table
+ * indexed by compatible, and az0x_cfg below reproduces it - extracted from
+ * snd-soc-inmusic-jp07.ko and cross-checked between the 6.6.119 and 6.18.26
+ * builds, which are byte-identical 16 months apart.
+ *
+ * Physical I/O on a Denon DJ Prime GO: headphone out, master out on XLR and
+ * RCA, booth out on 1/4", aux in on RCA, two mic combo inputs. That is three
+ * stereo output destinations for four DAI channels, so at least one has to be
+ * analogue fan-out.
+ *
+ * Channel map so far, established by playing mono into one channel at a time:
+ *
+ *	ch0, ch1  unknown - master and/or booth, not yet identified
+ *	ch2	  headphone / cue LEFT
+ *	ch3	  headphone / cue RIGHT
+ *
+ * Note that a plain stereo stream therefore lands on ch0/ch1 and is inaudible
+ * on headphones, which is a confusing first impression. The vendor's own driver
+ * has only generic OUT/IN widgets, so none of this is recoverable from the
+ * binaries - listening is the only way to extend the table.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <sound/pcm.h>
+#include <sound/soc.h>
+#include <sound/soc-dai.h>
+
+struct az0x_cfg {
+	unsigned int	rates;			/* SNDRV_PCM_RATE_* mask */
+	unsigned int	channels_max;		/* playback; capture is always 2 */
+	bool		has_capture;
+	unsigned int	enable_delay_ms;	/* after driving enable high */
+	unsigned int	reset_delay_ms;		/* after releasing reset */
+	bool		power_in_probe;		/* the vendor's "skip" flag */
+};
+
+struct az0x_codec {
+	const struct az0x_cfg	*cfg;
+	struct gpio_desc	*enable;
+	struct gpio_desc	*mute;
+	struct gpio_desc	*reset;
+	struct clk		*mclk;
+	struct snd_soc_dai_driver dai;
+	bool			powered;
+};
+
+static int az0x_codec_mute_stream(struct snd_soc_dai *dai, int mute, int dir)
+{
+	struct az0x_codec *priv = snd_soc_component_get_drvdata(dai->component);
+
+	if (priv->mute)
+		gpiod_set_value_cansleep(priv->mute, mute);
+
+	return 0;
+}
+
+static const struct snd_soc_dai_ops az0x_codec_dai_ops = {
+	.mute_stream	 = az0x_codec_mute_stream,
+	.no_capture_mute = 1,
+};
+
+/* Every board: S16_LE | S24_LE | S32_LE (0x444), channels_min 2. */
+#define AZ0X_FORMATS (SNDRV_PCM_FMTBIT_S16_LE | SNDRV_PCM_FMTBIT_S24_LE | \
+		      SNDRV_PCM_FMTBIT_S32_LE)
+
+static const struct snd_soc_dai_driver az0x_codec_dai_template = {
+	.name = "az0x-hifi",
+	.playback = {
+		.stream_name	= "Playback",
+		.formats	= AZ0X_FORMATS,
+		.channels_min	= 2,
+	},
+	.capture = {
+		.stream_name	= "Capture",
+		.formats	= AZ0X_FORMATS,
+		.channels_min	= 2,
+		.channels_max	= 2,
+	},
+	.ops = &az0x_codec_dai_ops,
+};
+
+static const struct snd_soc_dapm_widget az0x_codec_widgets[] = {
+	SND_SOC_DAPM_OUTPUT("OUT"),
+	SND_SOC_DAPM_INPUT("IN"),
+};
+
+static const struct snd_soc_dapm_route az0x_codec_routes[] = {
+	{ "OUT", NULL, "Playback" },
+	{ "Capture", NULL, "IN" },
+};
+
+/*
+ * Bring-up order and delays are the vendor's, and they are not incidental.
+ * Earlier revisions of this driver used ~1us for both waits, and later ones
+ * used the probe-time order on every board.
+ *
+ * The two paths really do differ in the vendor driver. At probe (JP11, JC16)
+ * it releases reset before switching the analogue supply on. At BIAS_STANDBY
+ * (every other board) it switches the supply on first and releases reset
+ * second. An SC6000 (JP13) brought up in the probe-time order consumes I2S
+ * frames but is silent on every output. MCLK starts last on both paths.
+ */
+static int az0x_codec_power_on(struct az0x_codec *priv)
+{
+	const struct az0x_cfg *cfg = priv->cfg;
+	int ret;
+
+	if (cfg->power_in_probe) {
+		gpiod_set_value_cansleep(priv->reset, 0);
+		msleep(cfg->reset_delay_ms);
+		gpiod_set_value_cansleep(priv->enable, 1);
+		msleep(cfg->enable_delay_ms);
+	} else {
+		gpiod_set_value_cansleep(priv->enable, 1);
+		msleep(cfg->enable_delay_ms);
+		gpiod_set_value_cansleep(priv->reset, 0);
+		msleep(cfg->reset_delay_ms);
+	}
+
+	ret = clk_prepare_enable(priv->mclk);
+	if (ret)
+		return ret;
+
+	priv->powered = true;
+	return 0;
+}
+
+/*
+ * The vendor powers the part on at the first BIAS_STANDBY transition, unless
+ * the board's table entry asks for it at probe; by then the card is up and the
+ * machine driver holds the clksel lines. idle_bias_on keeps the component at
+ * STANDBY or above from then on, so this runs once.
+ */
+static int az0x_codec_set_bias_level(struct snd_soc_component *component,
+				     enum snd_soc_bias_level level)
+{
+	struct az0x_codec *priv = snd_soc_component_get_drvdata(component);
+
+	if (level == SND_SOC_BIAS_STANDBY && !priv->powered)
+		return az0x_codec_power_on(priv);
+
+	return 0;
+}
+
+static const struct snd_soc_component_driver az0x_codec_component = {
+	.set_bias_level		= az0x_codec_set_bias_level,
+	.dapm_widgets		= az0x_codec_widgets,
+	.num_dapm_widgets	= ARRAY_SIZE(az0x_codec_widgets),
+	.dapm_routes		= az0x_codec_routes,
+	.num_dapm_routes	= ARRAY_SIZE(az0x_codec_routes),
+	.idle_bias_on		= 1,
+	.use_pmdown_time	= 1,
+	.endianness		= 1,
+};
+
+static void az0x_codec_disable_mclk(void *data)
+{
+	struct az0x_codec *priv = data;
+
+	if (priv->powered)
+		clk_disable_unprepare(priv->mclk);
+}
+
+static int az0x_codec_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct az0x_codec *priv;
+	int ret;
+
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	priv->cfg = of_device_get_match_data(dev);
+	if (!priv->cfg)
+		return -EINVAL;
+
+	/* Start muted, held in reset, unpowered - the vendor's probe state. */
+	priv->mute = devm_gpiod_get_optional(dev, "mute", GPIOD_OUT_HIGH);
+	if (IS_ERR(priv->mute))
+		return dev_err_probe(dev, PTR_ERR(priv->mute), "mute gpio\n");
+
+	priv->reset = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(priv->reset))
+		return dev_err_probe(dev, PTR_ERR(priv->reset), "reset gpio\n");
+
+	priv->enable = devm_gpiod_get_optional(dev, "enable", GPIOD_OUT_LOW);
+	if (IS_ERR(priv->enable))
+		return dev_err_probe(dev, PTR_ERR(priv->enable), "enable gpio\n");
+
+	priv->mclk = devm_clk_get_optional(dev, NULL);
+	if (IS_ERR(priv->mclk))
+		return dev_err_probe(dev, PTR_ERR(priv->mclk), "mclk\n");
+
+	ret = devm_add_action_or_reset(dev, az0x_codec_disable_mclk, priv);
+	if (ret)
+		return ret;
+
+	if (priv->cfg->power_in_probe) {
+		ret = az0x_codec_power_on(priv);
+		if (ret)
+			return dev_err_probe(dev, ret, "cannot enable mclk\n");
+	}
+
+	priv->dai = az0x_codec_dai_template;
+	priv->dai.playback.rates	= priv->cfg->rates;
+	priv->dai.playback.channels_max	= priv->cfg->channels_max;
+	priv->dai.capture.rates		= priv->cfg->rates;
+	if (!priv->cfg->has_capture)
+		memset(&priv->dai.capture, 0, sizeof(priv->dai.capture));
+
+	dev_set_drvdata(dev, priv);
+
+	return devm_snd_soc_register_component(dev, &az0x_codec_component,
+					       &priv->dai, 1);
+}
+
+/*
+ * The vendor table, verbatim. "Slow" boards (500/50) are the common case;
+ * JP11 and JC16 are the outliers at 10/200.
+ */
+#define AZ0X_RATES_ALL	(SNDRV_PCM_RATE_44100 | SNDRV_PCM_RATE_48000 | \
+			 SNDRV_PCM_RATE_88200 | SNDRV_PCM_RATE_96000)
+
+static const struct az0x_cfg az0x_cfg_44k1_2ch   = { SNDRV_PCM_RATE_44100, 2, true,  500,  50 };
+static const struct az0x_cfg az0x_cfg_44k1_4ch   = { SNDRV_PCM_RATE_44100, 4, true,  500,  50 };
+static const struct az0x_cfg az0x_cfg_44k1_6ch   = { SNDRV_PCM_RATE_44100, 6, true,  500,  50 };
+static const struct az0x_cfg az0x_cfg_44k1_8ch   = { SNDRV_PCM_RATE_44100, 8, true,  500,  50 };
+static const struct az0x_cfg az0x_cfg_48k_4ch    = { SNDRV_PCM_RATE_48000, 4, true,  500,  50 };
+static const struct az0x_cfg az0x_cfg_96k_6ch    = { SNDRV_PCM_RATE_96000, 6, true,  500,  50 };
+static const struct az0x_cfg az0x_cfg_all_4ch    = { AZ0X_RATES_ALL,       4, true,  500,  50 };
+static const struct az0x_cfg az0x_cfg_all_8ch    = { AZ0X_RATES_ALL,       8, true,  500,  50 };
+static const struct az0x_cfg az0x_cfg_all_4ch_np = { AZ0X_RATES_ALL,       4, false, 500,  50 };
+static const struct az0x_cfg az0x_cfg_all_2ch_np = { AZ0X_RATES_ALL,       2, false, 500,  50 };
+/* JP11 / JC16: fast enable, long reset settle, and the sequence runs at probe */
+static const struct az0x_cfg az0x_cfg_jp11       = { SNDRV_PCM_RATE_44100, 4, true,   10, 200, true };
+
+static const struct of_device_id az0x_codec_of_match[] = {
+	{ .compatible = "inmusic,acva-audio-codec", .data = &az0x_cfg_44k1_2ch   },
+	{ .compatible = "inmusic,acvk-audio-codec", .data = &az0x_cfg_44k1_6ch   },
+	{ .compatible = "inmusic,acvm-audio-codec", .data = &az0x_cfg_44k1_4ch   },
+	{ .compatible = "inmusic,acvr-audio-codec", .data = &az0x_cfg_44k1_2ch   },
+	{ .compatible = "inmusic,ada2-audio-codec", .data = &az0x_cfg_44k1_4ch   },
+	{ .compatible = "inmusic,az05-audio-codec", .data = &az0x_cfg_all_8ch    },
+	{ .compatible = "inmusic,hg02-audio-codec", .data = &az0x_cfg_48k_4ch    },
+	{ .compatible = "inmusic,hg03-audio-codec", .data = &az0x_cfg_96k_6ch    },
+	{ .compatible = "inmusic,hg04-audio-codec", .data = &az0x_cfg_all_4ch    },
+	{ .compatible = "inmusic,hg06-audio-codec", .data = &az0x_cfg_44k1_4ch   },
+	{ .compatible = "inmusic,hg08-audio-codec", .data = &az0x_cfg_96k_6ch    },
+	{ .compatible = "inmusic,hv01-audio-codec", .data = &az0x_cfg_all_8ch    },
+	{ .compatible = "inmusic,jc16-audio-codec", .data = &az0x_cfg_jp11       },
+	{ .compatible = "inmusic,jp07-audio-codec", .data = &az0x_cfg_all_4ch_np },
+	{ .compatible = "inmusic,jp08-audio-codec", .data = &az0x_cfg_all_4ch    },
+	{ .compatible = "inmusic,jp11-audio-codec", .data = &az0x_cfg_jp11       },
+	{ .compatible = "inmusic,jp12-audio-codec", .data = &az0x_cfg_all_2ch_np },
+	{ .compatible = "inmusic,ldmd-audio-codec", .data = &az0x_cfg_44k1_8ch   },
+	{ .compatible = "inmusic,mg01-audio-codec", .data = &az0x_cfg_all_8ch    },
+	/* az05 family: the vendor uses a separate module whose rates are fixed */
+	{ .compatible = "inmusic,nh08-audio-codec", .data = &az0x_cfg_44k1_4ch   },
+	{ .compatible = "inmusic,nh10-audio-codec", .data = &az0x_cfg_44k1_4ch   },
+	{ .compatible = "inmusic,jp20-audio-codec", .data = &az0x_cfg_44k1_8ch   },
+	{ .compatible = "inmusic,jp21-audio-codec", .data = &az0x_cfg_44k1_8ch   },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, az0x_codec_of_match);
+
+static struct platform_driver az0x_codec_driver = {
+	.driver = {
+		.name		= "az0x-audio-codec",
+		.of_match_table	= az0x_codec_of_match,
+	},
+	.probe = az0x_codec_probe,
+};
+module_platform_driver(az0x_codec_driver);
+
+MODULE_DESCRIPTION("inMusic AZ0x audio codec driver");
+MODULE_LICENSE("GPL");
